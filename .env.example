# Copy to .env and edit. Docker Compose reads .env automatically.

# sim   = simulated robot (no lab network needed, nothing moves)
# robot = real robot (lab network + teach pendant program in Play)
MODE=sim

# Open RViz as a Windows window (WSLg): true or false
RVIZ=true

# Required. Robot: 203, 204, 205 or 206
ROBOT_ID=206

# Required for MODE=robot. This PC's lab IP (WSL: ipconfig.exe | grep -a 10.172.21); also the teach pendant's External Control Host IP.
# Teach pendant External Control port: 500X1 (203 -> 50031 ... 206 -> 50061)
HOST_IP=10.172.21.156
